#!/usr/sbin/nft -f
#
# hearth — node firewall.
#
# Deployment model: the relays and TURN are reachable from the internet, like any other
# SimpleX server. The control plane is not. So this ruleset does two things:
#
#   1. inbound: publish exactly the relay/TURN ports and nothing else; keep the admin
#      API and ssh on the LAN;
#   2. outbound: keep the node from initiating connections it has no business making,
#      and make any attempt *visible* in a counter hearthd reads (expected value: 0).
#
# Install:
#   install -m 0644 hearth.nft /etc/hearth/nftables/hearth.nft
#   nft -c -f /etc/hearth/nftables/hearth.nft     # syntax check first
#   nft -f /etc/hearth/nftables/hearth.nft
#   # persist: /etc/nftables.conf -> include "/etc/hearth/nftables/hearth.nft"
#
# Verify:
#   nft list counters table inet hearth           # egress_drop should stay 0

table inet hearth {
    # ---------------------------------------------------------------- counters
    # Named, not anonymous: hearthd reads them by name every 30 seconds.
    counter egress_drop { }
    counter input_drop { }
    counter forward_drop { }
    counter smp_in { }
    counter xftp_in { }
    counter turn_in { }
    counter turn_media { }
    counter admin_in { }
    counter ssh_in { }

    # ------------------------------------------------------------------- sets
    # The LAN. Administration lives here; the messenger does not.
    # ==> ADJUST to your network, and keep it in step with node.lan_networks
    #     in /etc/hearth/hearthd.toml.
    set lan_nets {
        type ipv4_addr
        flags interval
        elements = { 192.168.1.0/24 }
    }

    # Ports the relays listen on. Keep in step with smp.port/extra_ports and
    # xftp.port in hearthd.toml.
    set relay_ports {
        type inet_service
        flags interval
        elements = { 443, 5223, 5443 }
    }

    # coturn's relay allocation range: keep in step with min-port/max-port in
    # turnserver.conf and turn.relay_min_port/max_port in hearthd.toml.
    # Without this open, a call connects and then stays silent — a miserable bug
    # to chase, because signalling looks perfectly healthy.
    define TURN_MIN = 49160
    define TURN_MAX = 49200

    # ------------------------------------------------------------------ input
    chain input {
        type filter hook input priority filter; policy drop;

        iif lo accept
        ct state established,related accept
        ct state invalid counter name input_drop drop

        # --- public: the messenger itself -------------------------------------
        tcp dport @relay_ports counter name smp_in accept
        # STUN/TURN signalling.
        udp dport 3478 counter name turn_in accept
        tcp dport 3478 counter name turn_in accept
        # TURN media relay. This is what actually carries a call between two phones
        # that are both behind NAT.
        udp dport $TURN_MIN-$TURN_MAX counter name turn_media accept

        # --- LAN only: administration ----------------------------------------
        ip saddr @lan_nets tcp dport 7443 counter name admin_in accept
        ip saddr @lan_nets tcp dport 22 counter name ssh_in accept

        # --- diagnostics -------------------------------------------------------
        # Rate-limited so the node cannot be used as an ICMP amplifier.
        icmp type { echo-request, destination-unreachable, time-exceeded } \
            limit rate 5/second accept
        ip6 nexthdr icmpv6 icmpv6 type { echo-request, destination-unreachable, \
            time-exceeded, nd-neighbor-solicit, nd-neighbor-advert } \
            limit rate 5/second accept

        # Everything else: counted, rate-limited log, dropped by policy.
        # On a public host this counter is genuinely noisy — the internet scans
        # constantly. That is expected; egress_drop is the one that must stay 0.
        counter name input_drop limit rate 5/second burst 10 packets \
            log prefix "hearth-in-drop " level info
        drop
    }

    # ---------------------------------------------------------------- forward
    # The node is not a router.
    chain forward {
        type filter hook forward priority filter; policy drop;
        counter name forward_drop limit rate 5/second burst 10 packets \
            log prefix "hearth-fwd-drop " level warn
        drop
    }

    # ----------------------------------------------------------------- output
    # The leak detector. Clients connect IN; nothing on this host has a reason to
    # start a connection out, with exactly one exception below.
    chain output {
        type filter hook output priority filter; policy drop;

        oif lo accept
        # Replies to clients that connected to us.
        ct state established,related accept
        # The LAN: backup target, alert channel, NTP on the router.
        ip daddr @lan_nets accept

        # --- the one real exception: TURN media -------------------------------
        # A relayed call means coturn sends packets to the *other* participant, who
        # is somewhere on the internet. That is genuinely new outbound traffic, not a
        # reply, so it has to be permitted explicitly.
        #
        # Scoped as tightly as the mechanism allows: only the turnserver user, only
        # UDP, only from the allocation range. Everything else on this host — the
        # relays included — still cannot open an outbound connection without landing
        # in egress_drop.
        meta skuid "turnserver" udp sport $TURN_MIN-$TURN_MAX accept

        # Noise the OS emits that would otherwise drown the signal.
        ip daddr { 224.0.0.0/4, 255.255.255.255 } udp dport { 5353, 1900, 137, 138 } drop

        counter name egress_drop limit rate 10/second burst 20 packets \
            log prefix "hearth-egress-drop " level warn
        drop
    }
}

# ---------------------------------------------------------------------------
# Notes on things that will bite you
#
# * Port 443 needs CAP_NET_BIND_SERVICE on smp-server (the shipped unit has it).
#
# * If this host is behind NAT, coturn needs `external-ip=<public>/<private>` or it
#   will advertise an unreachable candidate and calls will fail after signalling.
#
# * The node has no resolver (see the runbook). If node.host is a dynamic DNS name,
#   the *router* updates it, not this machine — that keeps egress_drop clean.
#
# * Getting a TLS certificate for turns: needs temporary outbound access. Open it,
#   run certbot, close it, and note the egress_drop bump in the journal so you do not
#   later investigate your own maintenance window.
# ---------------------------------------------------------------------------
