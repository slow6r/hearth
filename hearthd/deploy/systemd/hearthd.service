[Unit]
Description=hearth control plane (supervisor, egress watchdog, integrity, backup)
Documentation=file:///opt/hearth/docs/architecture.md
After=network-online.target nftables.service
Wants=network-online.target
Requires=nftables.service
# Свои каталоги демон обязан ДОЖДАТЬСЯ. На боевом узле /var/opt/hearth — отдельная
# точка монтирования (deploy/systemd/var-opt-hearth.mount: /var всего 12 GiB, данные
# лежат на /srv), а /var/lib/hearth бывает вынесен так же. Без этой строки systemd
# вправе запустить демон раньше монтирования, и он увидит пустой каталог состояния:
# режим узла «потерян» (карантин снимается сам собой), журнал алертов начинается
# заново, бэкап пишет мимо раздела — и всё это молча, поверх смонтированных позже
# настоящих файлов. Гейтовый drop-in ждёт монтирования по той же причине
# (relay.service.d-hearth-mode.conf); демон ждать был не обязан — это и был перекос.
# Пути поставочные; install.sh дописывает сюда реальный paths.state_dir, если он на
# узле другой.
RequiresMountsFor=/var/lib/hearth /var/opt/hearth

[Service]
Type=exec
ExecStart=/usr/local/bin/hearthd --config /etc/hearth/hearthd.toml run
Restart=on-failure
RestartSec=5s
# Состояния, из которых узел сам не выйдет, НЕ перезапускаются.
#
# Провал preflight (нет /etc/hearth/pki/ca.pem, нет /etc/hearth/manifest.toml) не
# лечится повторным запуском: файла не появится оттого, что процесс стартовал ещё раз.
# С Restart=on-failure и RestartSec=5s это давало вечный цикл — каждые пять секунд
# демон заново записывал карантин, заново останавливал релеи и заново слал алерт, а
# `hearthctl mode clear --local` не выводил: следующий запуск возвращал запрет. При
# интервале в 5 с StartLimitBurst (5 стартов за 10 с) не срабатывает никогда.
#
# 78 — EX_CONFIG из sysexits(3), «ошибка в конфигурации узла»; hearthd отдаёт его
# ровно в этом случае (EXIT_TERMINAL в src/bin/hearthd.rs). Юнит останавливается один
# раз, с причиной и инструкцией в журнале.
RestartPreventExitStatus=78

User=hearth
Group=hearth
# Reads nft counters and journal, controls the relay units.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
# systemd-journal: read the netfilter LOG entries behind an egress incident.
# simplex:         read the relay fingerprint for bundles and archive the relay
#                  directories in the nightly backup.
# simplex-ntf:     archive the push server's directories (ADR 0016). The group is
#                  created by install.sh on every node, with or without push: systemd
#                  refuses to start a unit that names a group which does not exist
#                  (status=216/GROUP), so run install.sh before installing this unit.
SupplementaryGroups=systemd-journal simplex simplex-ntf

# Deliberately NOT granted: CAP_SYS_PTRACE. It would let `ss -p` name the relays'
# sockets (making the socket scan a full second signal instead of a degraded one),
# but it would also let this daemon read the relay's memory — that is, message
# content. ТЗ §7.4 says hearthd never sees that, and a degraded scan is the cheaper
# price. `hearthctl egress` reports the degradation rather than hiding it.

# --- sandbox -----------------------------------------------------------------
# hearthd is the one piece of code written for this project; it gets the tightest
# box that still lets it do its job (ТЗ §7.2).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# No outbound sockets outside the home networks are possible anyway (nftables +
# EgressPolicy); this keeps the address families minimal as well.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Writable state only where it belongs (ТЗ §10.1).
#
# The coturn config is rewritten from the template on every secret rotation. Listing
# `/etc/turnserver.conf` here was not enough: the write is atomic, so it creates
# `/etc/turnserver.conf.tmp.<pid>` first, and ProtectSystem=strict keeps /etc itself
# read-only — the rotation failed with EROFS. The rendered config lives in
# /etc/hearth/turn/ instead, inside a directory this daemon already owns.
ReadWritePaths=/var/lib/hearth /var/opt/hearth /etc/hearth
# The relay state: read for the fingerprint that goes into bundles, and read again by
# the nightly backup. /var/opt/simplex holds the store log — needed by the backup.
ReadOnlyPaths=/etc/opt/simplex /etc/opt/simplex-xftp /var/opt/simplex /var/opt/simplex-xftp
# The push server's CA and its database dump (ADR 0016). `-`: most nodes have no push
# server, and a missing path must not keep the control plane from starting.
ReadOnlyPaths=-/etc/opt/simplex-ntf -/var/opt/simplex-ntf

# journald is the alert journal of record.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hearthd

[Install]
WantedBy=multi-user.target
