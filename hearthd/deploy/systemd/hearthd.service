[Unit]
Description=hearth control plane (supervisor, egress watchdog, integrity, backup)
Documentation=file:///opt/hearth/docs/architecture.md
After=network-online.target nftables.service
Wants=network-online.target
Requires=nftables.service

[Service]
Type=exec
ExecStart=/usr/local/bin/hearthd --config /etc/hearth/hearthd.toml run
Restart=on-failure
RestartSec=5s

User=hearth
Group=hearth
# Reads nft counters and journal, controls the relay units.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
# systemd-journal: read the netfilter LOG entries behind an egress incident.
# simplex:         read the relay fingerprint for bundles and archive the relay
#                  directories in the nightly backup.
SupplementaryGroups=systemd-journal simplex

# Deliberately NOT granted: CAP_SYS_PTRACE. It would let `ss -p` name the relays'
# sockets (making the socket scan a full second signal instead of a degraded one),
# but it would also let this daemon read the relay's memory — that is, message
# content. ТЗ §7.4 says hearthd never sees that, and a degraded scan is the cheaper
# price. `hearthctl egress` reports the degradation rather than hiding it.

# --- sandbox -----------------------------------------------------------------
# hearthd is the one piece of code written for this project; it gets the tightest
# box that still lets it do its job (ТЗ §7.2).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# No outbound sockets outside the home networks are possible anyway (nftables +
# EgressPolicy); this keeps the address families minimal as well.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Writable state only where it belongs (ТЗ §10.1).
#
# The coturn config is rewritten from the template on every secret rotation. Listing
# `/etc/turnserver.conf` here was not enough: the write is atomic, so it creates
# `/etc/turnserver.conf.tmp.<pid>` first, and ProtectSystem=strict keeps /etc itself
# read-only — the rotation failed with EROFS. The rendered config lives in
# /etc/hearth/turn/ instead, inside a directory this daemon already owns.
ReadWritePaths=/var/lib/hearth /var/opt/hearth /etc/hearth
# The relay state: read for the fingerprint that goes into bundles, and read again by
# the nightly backup. /var/opt/simplex holds the store log — needed by the backup.
ReadOnlyPaths=/etc/opt/simplex /etc/opt/simplex-xftp /var/opt/simplex /var/opt/simplex-xftp

# journald is the alert journal of record.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hearthd

[Install]
WantedBy=multi-user.target
