[Unit]
Description=SimpleX SMP relay (upstream binary, unmodified)
Documentation=https://github.com/simplex-chat/simplexmq
After=network-online.target nftables.service
Wants=network-online.target
Requires=nftables.service
# Данные релея могут жить под bind-mount'ом (deploy/systemd/var-opt-*.mount). Без этой
# строки при неудачном порядке загрузки store log пишется в каталог ПОД точкой
# монтирования: релей работает, а перенос узла увезёт не те данные.
RequiresMountsFor=/var/opt/simplex /etc/opt/simplex

[Service]
Type=simple
ExecStart=/usr/local/bin/smp-server start +RTS -N -RTS
Restart=on-failure
RestartSec=5s
# Give the store log time to flush on stop; losing it loses undelivered messages.
TimeoutStopSec=60
KillSignal=SIGINT

User=simplex
Group=simplex
LimitNOFILE=65535
# Port 443 is below 1024: without this the relay cannot bind it (upstream unit
# carries the same capability).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

ReadWritePaths=/var/opt/simplex
ReadOnlyPaths=/etc/opt/simplex

StandardOutput=journal
StandardError=journal
SyslogIdentifier=smp-server

[Install]
WantedBy=multi-user.target
