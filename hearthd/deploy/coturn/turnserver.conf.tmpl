# coturn — hearth (ТЗ §6.4).
#
# Rendered by hearthd on every `hearthctl rotate turn-secret` from
# /etc/hearth/templates/turnserver.conf.tmpl to /etc/turnserver.conf.
# Плейсхолдеры (каждый — имя в двойных фигурных скобках):
#   PORT, TLS_PORT_LINE, REALM, TURN_SECRET, MIN_PORT, MAX_PORT
#
# ЗДЕСЬ ОНИ НАПИСАНЫ БЕЗ СКОБОК НАМЕРЕННО. render_config подставляет значения по всему
# файлу, комментарии не исключение. TLS_PORT_LINE разворачивается в ДВЕ строки
# (`no-tls` + `no-dtls`), поэтому строка-комментарий со списком плейсхолдеров рвалась
# пополам, и её вторая половина становилась настоящей строкой конфига:
#   no-dtls hearth <секрет> 49160 49200
# coturn отвечал «ERROR: Unknown boolean value» и не стартовал.
#
# DO NOT edit /etc/turnserver.conf by hand — the next rotation overwrites it.
#
# This server is REACHABLE FROM THE INTERNET, and it has to be: when both callers are
# behind NAT (two phones on mobile networks), a relay is the only way a media path
# exists at all. Everything below exists to make a public relay safe.

# --- binding ---------------------------------------------------------------
# Listen on every interface: clients arrive from anywhere. If this host has several
# addresses, pin the right one with `listening-ip` and set `external-ip` when behind
# NAT (external-ip=<public>/<private>) or ICE will advertise an unreachable candidate.
listening-port={{PORT}}
# --- this node (fels, 192.168.1.72) ----------------------------------------
# The host has five addresses (LAN, ZeroTier, two Docker bridges, loopback). Pin the
# LAN one: that is where the router forwards 3478 and the relay range to.
listening-ip=192.168.1.72
relay-ip=192.168.1.72
# The node is behind the provider NAT. Without this coturn advertises 192.168.1.72 as
# an ICE candidate, signalling succeeds and the call is then silent.
# <public>/<private>. If the ISP address changes, THIS LINE MUST CHANGE TOO.
external-ip=185.145.126.254/192.168.1.72

{{TLS_PORT_LINE}}
fingerprint

# Relay port range. MUST be open in the firewall — signalling succeeds without it and
# then the call is silent, which is a miserable thing to debug.
min-port={{MIN_PORT}}
max-port={{MAX_PORT}}

# --- authentication --------------------------------------------------------
# Short-lived credentials derived from a rotating static secret (TURN REST scheme).
# hearthd mints them into each device's bundle; there is no user database to maintain
# and nothing long-lived to leak.
use-auth-secret
static-auth-secret={{TURN_SECRET}}
realm={{REALM}}
stale-nonce=600

# --- what this relay may be pointed at -------------------------------------
# A TURN server forwards packets on behalf of whoever authenticates. On a public
# server that makes two things possible unless they are shut off explicitly:
#   1. reaching this machine's own LAN and loopback (an SSRF into the home network);
#   2. bouncing traffic at third parties.
# Deny every private, loopback, link-local and reserved range. Public peers stay
# allowed, which is all a call between two family members needs.
no-multicast-peers
# `no-loopback-peers` был здесь и ломал старт: coturn 4.6.1 такого ключа не знает
# («Bad configuration format»), и сервер не поднимается вообще. Ключ убрали в 4.6.0 —
# теперь loopback запрещён ПО УМОЛЧАНИЮ, а разрешает его обратный `allow-loopback-peers`.
# Так что нужное поведение получается само; диапазон 127.0.0.0/8 ниже оставлен явно,
# чтобы правило было видно в файле, а не только в дефолтах чужой версии.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
denied-peer-ip=::ffff:0.0.0.0-::ffff:255.255.255.255
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# --- limits ----------------------------------------------------------------
# A family-sized contour, on a public port. Bound what an authenticated client can do,
# so a leaked bundle cannot turn this into someone's free relay.
total-quota=100
user-quota=6
max-bps=2000000

# --- privacy / operations --------------------------------------------------
# coturn logs allocations, which contain client addresses. Keep it minimal and rotate.
simple-log
log-file=/var/log/coturn/turnserver.log
no-cli
proc-user=turnserver
proc-group=turnserver
pidfile=/run/coturn/turnserver.pid
