# file-server.ini — эталон намерений hearth (ТЗ §6.3).
#
# Как и для smp: источник истины — то, что сгенерировал `xftp-server init` вашего
# пинованного тега. Сверка:
#
#   ./verify-ini-keys.sh /etc/opt/simplex-xftp/file-server.ini xftp/file-server.ini.example

[STORE_LOG]
enable: on
log_stats: off

[TRANSPORT]
# ТЗ §5.1 / A1: только адрес узла.
host: 10.66.10.10
port: 5443
# Control port на loopback — health-check hearthd.
control_port: 5444
log_tls_errors: off

[AUTH]
# ТЗ §6.3: пароль на загрузку файлов. Значение подставляет init-xftp.sh;
# копия — в /etc/hearth/secrets/xftp-create-password.
new_files: on
create_password: REPLACE_WITH_GENERATED_PASSWORD

[STORAGE]
# ТЗ §6.3: квота 32 ГБ, TTL 7 дней. Размер одного файла ограничен upstream (1 ГБ)
# и здесь не настраивается.
# Имена ключей и единицы измерения обязательно сверить с версией.
quota: 32gb
files_path: /var/opt/simplex-xftp/files
log_path: /var/opt/simplex-xftp/file-server-store.log
file_expiration_hours: 168
