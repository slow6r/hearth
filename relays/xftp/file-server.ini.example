# file-server.ini — целевая конфигурация hearth (XFTP).
#
# Ключи сверены с исходниками simplexmq v7.0.1
# (src/Simplex/FileTransfer/Server/Main.hs). Сверка после обновления:
#
#   ./verify-ini-keys.sh /etc/opt/simplex-xftp/file-server.ini xftp/file-server.ini.example

[STORE_LOG]
enable = on
log_stats = off
# TTL файлов. 7 суток: достаточно, чтобы забрать, и не превращает узел в файлопомойку.
expire_files_hours = 168

[AUTH]
# Загружать файлы можно только с паролем — на публично доступном сервере это
# единственное, что мешает посторонним использовать его как хранилище.
new_files = on
create_password = REPLACE_WITH_GENERATED_PASSWORD
control_port_admin_password = REPLACE_WITH_GENERATED_PASSWORD
control_port_user_password = REPLACE_WITH_GENERATED_PASSWORD

[TRANSPORT]
# Как и у smp: host только печатается при старте, не биндит.
host = relay.example.org
port = 5443
control_port = 5444
log_tls_errors = off

[FILES]
# Общая квота хранилища. Размер одного файла ограничен upstream и здесь не настраивается.
storage_quota = 32gb
