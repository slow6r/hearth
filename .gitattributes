# Переводы строк.
#
# Всё, что уезжает на узел или исполняется на Linux, обязано быть LF независимо от того,
# на какой машине сделан checkout. Без этого файла при `core.autocrlf=true` (обычная
# настройка Git для Windows) рабочее дерево получает CRLF — и дальше ломается тихо и
# по-разному:
#
#   * bash падает на первой же строке скрипта: `set -euo pipefail\r` превращается в
#     «set: pipefail: invalid option name». Ровно так не запускались install.sh,
#     build-ntf-server.sh и init-ntf.sh — при том что сами файлы выглядят целыми;
#   * nft-правила, systemd-юниты и конфиги приезжают на узел с \r в конце каждой строки;
#   * `diff` ветки с боевым узлом показывает различие В КАЖДОЙ СТРОКЕ, и настоящие
#     отличия в этом шуме не разглядеть.
#
# Проверка: `git ls-files --eol` — второй столбец обязан быть w/lf.
#
# Список намеренно точечный, а не `* text=auto`: правило меняет рабочее дерево у всех,
# кто сделает checkout, и расширять его на весь репозиторий (Kotlin, Markdown) незачем —
# те файлы на узле не исполняются.

*.sh        text eol=lf
*.nft       text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.mount     text eol=lf
*.rules     text eol=lf
*.tmpl      text eol=lf
*.conf      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.example   text eol=lf
*.yml       text eol=lf

# Исполняемые файлы без расширения: под общие маски выше они не попадают, а ломаются
# так же. hearth-beep — канал критических алертов, его ставит install.sh; остальные два
# запускаются по таймерам systemd.
hearthd/deploy/hearth-beep                      text eol=lf
hearthd/deploy/monitoring/hearth-alert-sink     text eol=lf
hearthd/deploy/monitoring/hearth-relay-metrics  text eol=lf

# Патчи применяются побайтово: любая конвертация ломает `git apply`.
*.patch     -text

# Ключи, сертификаты и бинарное — не трогать вовсе.
*.pem       -text
*.p8        -text
*.apk       binary
*.jar       binary
*.so        binary
*.keystore  binary
