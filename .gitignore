# --- Rust ---
/hearthd/target/
**/*.rs.bk

# --- Android ---
/android/simplex-chat/          # submodule форка, если добавлен не как submodule
*.apk
*.aab
*.keystore
*.jks
local.properties
.gradle/
build/

# --- Секреты (дублирует keys/.gitignore; лучше два замка, чем один) ---
*.key
*.pem
*identity*
age-key*.txt
*secret*
*.p12
*.pfx
# Исключения: шаблоны и примеры, в которых секретов нет
!**/*.example
!**/*.tmpl

# --- Локальное состояние узла, если кто-то запустил hearthd из репозитория ---
/var/
/etc/
devices.json
alerts.jsonl
egress-incidents.jsonl
*.tar.gz.age

# --- Мусор ОС и редакторов ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
__pycache__/

# --- Форк upstream и артефакты сборки ---
# Форк подключается как submodule (android/README.md) и в этот репозиторий не
# вкладывается: здесь только overlay-файлы, описания патчей и скрипты.
/android/simplex-chat/
# Собранные APK и подписи — артефакты, а не исходники. Для сверки достаточно
# отпечатка ключа в keys/apksigner-fingerprints.txt.
/android/*.apk
/android/*.apk.idsig

# Готовые сборки клиентов. В git не кладём: APK и MSI весят сотни мегабайт, а
# собираются из исходников одной командой. Раздаются через узел и вручную.
/android/*.apk
/android/*.apk.idsig
/desktop/*.msi
/desktop/*.exe
# Нативные библиотеки Windows из релиза upstream: 258 МБ, восстанавливаются
# по инструкции в android/README.md с проверкой хеша.
/android/desktop-runtime/

# Результат relays/ntf/build-ntf-server.sh: бинарь ntf-server весит 50 МБ. В git ему
# делать нечего — из истории такой объект потом не выкинуть. Связь бинаря с исходниками
# держится не файлом, а манифестом узла: sha256 пиннится через `hearthctl manifest pin`,
# а версия, коммит simplexmq и хеш патча записаны в docs/deploy-fels-2026-09-09.md.
relays/ntf/dist/

# Наборы стикеров, скачанные из Telegram: чужие картинки, в репозиторий не кладём.
# Раздаёт узел из /srv/hearth/stickers; источник восстанавливается import-telegram.py.
stickers/dist/
