# --- Rust ---
/hearthd/target/
**/*.rs.bk

# --- Android ---
/android/simplex-chat/          # submodule форка, если добавлен не как submodule
*.apk
*.aab
*.keystore
*.jks
local.properties
.gradle/
build/

# --- Секреты (дублирует keys/.gitignore; лучше два замка, чем один) ---
*.key
*.pem
*identity*
age-key*.txt
*secret*
*.p12
*.pfx
# Исключения: шаблоны и примеры, в которых секретов нет
!**/*.example
!**/*.tmpl

# --- Локальное состояние узла, если кто-то запустил hearthd из репозитория ---
/var/
/etc/
devices.json
alerts.jsonl
egress-incidents.jsonl
*.tar.gz.age

# --- Мусор ОС и редакторов ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# --- Форк upstream и артефакты сборки ---
# Форк подключается как submodule (android/README.md) и в этот репозиторий не
# вкладывается: здесь только overlay-файлы, описания патчей и скрипты.
/android/simplex-chat/
# Собранные APK и подписи — артефакты, а не исходники. Для сверки достаточно
# отпечатка ключа в keys/apksigner-fingerprints.txt.
/android/*.apk
/android/*.apk.idsig

# Готовые сборки клиентов. В git не кладём: APK и MSI весят сотни мегабайт, а
# собираются из исходников одной командой. Раздаются через узел и вручную.
/android/*.apk
/android/*.apk.idsig
/desktop/*.msi
/desktop/*.exe
