@@ -138,7 +138,27 @@ class SimplexApp: Application(), LifecycleEventObserver {
           // это потерянные подписки. Мягкий аналог выключить/включить — переподключить
           // релеи, не чаще раза в минуту. См. HearthResume.
           if (chatModel.chatRunning.value == true && chat.hearth.HearthResume.claim(System.currentTimeMillis())) {
-            withBGApi { chatModel.controller.reconnectAllServers(null) }
+            withBGApi {
+              chatModel.controller.reconnectAllServers(null)
+              // hearth (UPD-8): страховочный повтор приведения к своему узлу. Цепочка
+              // помечается выполненной, только если ВСЕ шаги ответили Done, — но
+              // повторить незаконченную было некому: startChat за жизнь процесса
+              // случается один раз. Телефон, у которого шаг не прошёл (ядро было не
+              // готово, сети не было), оставался неприведённым до перезапуска
+              // приложения.
+              //
+              // Вызов НЕ бесплатный, вопреки тому, что здесь было написано раньше:
+              // шаг «порт релея» ходит в сеть. Поэтому повтор ограничен не только
+              // минутой HearthResume, но и собственным правилом цепочки — не чаще
+              // раза в четверть часа и не больше шести раз за жизнь процесса
+              // (HearthStartup.MIN_GAP_MS, MAX_ATTEMPTS). Без этого незаведённое
+              // устройство выполняло бы шаги на каждый выход на передний план — на
+              // том самом пути, где человек ждёт список чатов.
+              chat.hearth.hearthAfterChatStarted()
+              // И заодно перечитать, заведено ли устройство на узле: это решает, что
+              // показывает плашка над списком чатов. Локальный запрос к ядру, без сети.
+              chat.hearth.hearthNoteNodeSetup()
+            }
           }
           chat.hearth.HearthBadge.sync(SimplexApp.context)
         }
