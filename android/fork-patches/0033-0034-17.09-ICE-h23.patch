+package chat.hearth
+
+/**
+ * На настольной сборке обновления не раздаются: APK там не ставится, а собственного
+ * канала обновлений у desktop-сборки в этом контуре пока нет. Проверять нечего —
+ * и молчать не о чем, поэтому шаг пустой, а не «не реализовано».
+ *
+ * Когда настольные сборки начнут раздаваться так же, как Android-сборки, это станет
+ * копией androidMain — как и у [hearthRefreshIceServers].
+ */
+actual suspend fun hearthCheckUpdatesQuietly() = Unit
