+    var checked: Long? = null
+    var firstSeen: Long? = null
+    val checker = HearthUpdateChecker(
+      transport = Fake(manifest, signature = null),
+      installedVersionCode = 1,
+      pinnedKey = "key",
+      verify = { _, _, _ -> true },
+      nowEpochDays = today,
+      rememberFirstSeenDay = { firstSeen = it },
+      rememberCheckedDay = { checked = it },
