Карточку заводит ядро при создании профиля; человек её не просил, и по нажатию
телефон пошёл бы соединяться с чужим ботом на публичном сервере, куда наша сборка
ходить не должна. В списке чатов, адресе и поиске upstream карточки уже прячет —
показывал их только лист «Новый чат» (contactListChatPredicate). То же сделано в
Android (NewChatSheet.kt, ContactType.CARD убран).

Запись в базе остаётся, но не видна нигде. Android дополнительно стирает её при
запуске (HearthPresetCards.kt); на iOS это пока не перенесено.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 apps/ios/Shared/Views/NewChat/NewChatMenuButton.swift | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/apps/ios/Shared/Views/NewChat/NewChatMenuButton.swift b/apps/ios/Shared/Views/NewChat/NewChatMenuButton.swift
index 416dc32..97c77cc 100644
--- a/apps/ios/Shared/Views/NewChat/NewChatMenuButton.swift
+++ b/apps/ios/Shared/Views/NewChat/NewChatMenuButton.swift
@@ -172,7 +172,12 @@ struct NewChatSheet: View {
     private func contactListChatPredicate(_ chat: Chat, _ withSearch: Bool) -> Bool {
         switch chat.chatInfo {
         case .contactRequest: true
-        case let .direct(contact): contact.isContactCard || contact.active || (contact.chatDeleted && withSearch)
+        // hearth: карточки контактов не показываются. Единственная, которая тут бывает, —
+        // «Ask SimpleX Team»: её заводит ядро при создании профиля, человек её не просил,
+        // и по нажатию телефон пошёл бы соединяться с чужим ботом на публичном сервере,
+        // куда наша сборка ходить не должна. В списке чатов upstream карточки уже прячет,
+        // показывал их только этот лист. То же сделано в Android (NewChatSheet.kt).
+        case let .direct(contact): !contact.isContactCard && (contact.active || (contact.chatDeleted && withSearch))
         default: false
         }
     }
