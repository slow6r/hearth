Описание — hearth/android/patches/0012-abi-arm64-only.md.

-Pandroid.injected.build.abi заставлял AGP пометить APK testOnly, и Android
отказывался его ставить. Ограничение ABI перенесено в build.gradle.kts, версия
7.0.1-h3 / 374.
---
 apps/multiplatform/android/build.gradle.kts | 19 ++++++++++++-------
 apps/multiplatform/gradle.properties        |  4 ++--
 2 files changed, 14 insertions(+), 9 deletions(-)

diff --git a/apps/multiplatform/android/build.gradle.kts b/apps/multiplatform/android/build.gradle.kts
index 94794db..8bd96b6 100644
--- a/apps/multiplatform/android/build.gradle.kts
+++ b/apps/multiplatform/android/build.gradle.kts
@@ -135,19 +135,24 @@ android {
         "zh-rCN"
     )
     ndkVersion = "23.1.7779620"
+    // hearth (patches/0012): только arm64-v8a. Причин две. Первая — ТЗ §8.4: 32-битных
+    // устройств в семье нет, а лишний ABI это лишний код в сборке. Вторая важнее:
+    // нативное ядро мы не собираем, а берём .so из релизного APK upstream, и лежит
+    // там только arm64-v8a — сборка armeabi-v7a просто падает на отсутствии библиотек.
+    //
+    // Ограничение задаётся ЗДЕСЬ, а не флагом -Pandroid.injected.build.abi: тот флаг
+    // означает «деплой из IDE на подключённое устройство», и AGP помечает такой APK
+    // как testOnly. Android отказывается ставить его обычным способом — «приложение
+    // предназначено только для тестирования».
     if (isBundle) {
-        defaultConfig.ndk.abiFilters("arm64-v8a", "armeabi-v7a")
+        defaultConfig.ndk.abiFilters("arm64-v8a")
     } else {
         splits {
             abi {
                 isEnable = true
                 reset()
-                if (isRelease) {
-                    include("arm64-v8a", "armeabi-v7a")
-                } else {
-                    include("arm64-v8a", "armeabi-v7a")
-                    isUniversalApk = false
-                }
+                include("arm64-v8a")
+                isUniversalApk = false
             }
         }
     }
diff --git a/apps/multiplatform/gradle.properties b/apps/multiplatform/gradle.properties
index 6f67a2b..0142323 100644
--- a/apps/multiplatform/gradle.properties
+++ b/apps/multiplatform/gradle.properties
@@ -26,8 +26,8 @@ kotlin.jvm.target=11
 
 # hearth: своя нумерация поверх тега upstream. versionCode обязан расти
 # монотонно — по нему приложение решает, новее ли сборка на узле.
-android.version_name=7.0.1-h2
-android.version_code=373
+android.version_name=7.0.1-h3
+android.version_code=374
 
 desktop.version_name=7.0.1
 desktop.version_code=157
