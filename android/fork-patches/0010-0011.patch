index b534bcd..fcca9f9 100644
--- a/apps/multiplatform/android/src/main/AndroidManifest.xml
+++ b/apps/multiplatform/android/src/main/AndroidManifest.xml
@@ -10,6 +10,15 @@
   <!-- hearth (patches/0005): этих разрешений форк не просит никогда. Upstream их тоже
        не просит, но манифест собирается слиянием с манифестами библиотек, и tools:node
        не даст вернуть их незаметно при добавлении зависимости (ТЗ §8.3, A5). -->
+  <!-- hearth (ADR 0010): установка обновления, скачанного с СВОЕГО узла.
+       Это заметное разрешение — право ставить произвольные APK, — и patches/0005
+       разрешения наоборот вычищает. Размен назван в ADR: без него обновление не
+       доедет до того, кто в отъезде, а именно он дольше всех остаётся с дырой. -->
+  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
+  <!-- Загрузка идёт в foreground-сервисе: с Android 14 такому сервису обязателен
+       объявленный тип, иначе система его не запустит. -->
+  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
+
   <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" tools:node="remove" />
   <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
   <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
@@ -161,6 +170,13 @@
         android:autoRemoveFromRecents="true"
         android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"/>
 
+    <!-- hearth: фоновая загрузка обновления. exported=false — снаружи его дёргать
+         незачем, запускает только само приложение. -->
