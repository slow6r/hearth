@@ -0,0 +1,54 @@
+package chat.hearth
+
+import androidx.compose.foundation.Image
+import androidx.compose.foundation.layout.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.toArgb
+import androidx.compose.ui.unit.dp
+import boofcv.alg.fiducial.qrcode.QrCode
+import chat.simplex.common.ui.theme.DEFAULT_PADDING
+import chat.simplex.common.ui.theme.DEFAULT_PADDING_HALF
+import chat.simplex.common.views.newchat.qrCodeBitmap
+import chat.simplex.common.views.newchat.replaceColor
+import chat.simplex.common.views.helpers.*
+import chat.simplex.res.MR
+import dev.icerock.moko.resources.compose.stringResource
+
+/**
+ * QR с секретом — без «поделиться».
+ *
+ * # Зачем свой, а не upstream'овский
+ *
+ * `QRCode` из upstream вешает на картинку `clickable`, который сохраняет её во
+ * временный файл и отдаёт в системный выбор приложений. Для ссылки-приглашения это
+ * удобно и безопасно. Для нашего QR настроек узла — нет: в нём пароли релеев и
+ * токен устройства. Один промах по картинке (Галерея, облачный клиент, любой
+ * мессенджер) выносит их за контур, а `FLAG_SECURE` от этого не спасает вовсе — он
+ * запрещает скриншот, а не `ACTION_SEND`.
+ *
+ * Поэтому здесь та же отрисовка без обработчика касания. Отдельный файл в overlay, а
+ * не правка upstream: так ребейз на новый тег не потеряет это решение и не потребует
+ * разрешать конфликт в чужом файле.
+ */
+@Composable
+fun HearthSecretQR(payload: String) {
+  val tint = Color(0xff2e1d12)
+  val qr: androidx.compose.ui.graphics.ImageBitmap = remember(payload) {
+    qrCodeBitmap(payload, 1024, QrCode.ErrorLevel.L)
+      .replaceColor(Color.Black.toArgb(), tint.toArgb())
+  }
+  Box(Modifier.fillMaxWidth(), contentAlignment = Alignment.Center) {
+    Image(
+      bitmap = qr,
+      contentDescription = stringResource(MR.strings.image_descr_qr_code),
+      modifier = Modifier
+        .padding(horizontal = DEFAULT_PADDING * 2f, vertical = DEFAULT_PADDING_HALF)
+        .widthIn(max = 400.dp)
+        .fillMaxWidth()
+        .aspectRatio(1f),
+    )
+  }
+}
