+const val HEARTH_SHORT_LINK_PREFIX = "hearth://"
+
+/**
+ * Короткая ссылка ядра: `https://<сервер>/<тип>#<данные>`, тип — одна буква
+ * (`i` одноразовая, `a` адрес, `g` группа, `r` релей).
