+ * посимвольно, меняется только схема.
+ */
+private val CORE_SHORT_LINK = Regex("^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?/[a-z]#")
 
 /**
  * Ссылка в том виде, в каком её показывают и передают.
  *
- * upstream переписывал `simplex:/…` в `https://simplex.chat/…`, то есть звал человека
- * на чужой сайт и подписывал наши приглашения чужим доменом. Мы переписываем в свою
- * схему.
+ * Полная `simplex:/…` становится `hearth:/…`, короткая `https://…/i#…` —
+ * `hearth://…/i#…`. upstream вместо этого переписывал полную ссылку в
+ * `https://simplex.chat/…`, то есть подписывал наши приглашения чужим доменом.
  *
- * Это подмена ТОЛЬКО на границе показа. Ядру всегда уходит `simplex:/…` — форматы
- * адресов и разбор не трогаются (ТЗ §8.3), Haskell не правится ни строкой. Обратная
- * замена делается в одном месте на входе — [hearthLinkToCore], — через которое
- * проходят все ссылки: сканер, вставка, нажатие в чате, открытие по ссылке извне.
+ * Это подмена ТОЛЬКО на границе показа. Ядру всегда уходит ровно то, что оно выдало:
+ * форматы адресов не трогаются (ТЗ §8.3), Haskell не правится ни строкой. Обратная
+ * замена — [hearthLinksToCore] — стоит там, где текст попадает в ядро: в разборе
+ * вставленного и отсканированного (`strConnectTarget`), в `planAndConnect` и в тексте
+ * отправляемого сообщения (`ComposeView.checkLinkPreview`).
+ */
+fun simplexChatLink(uri: String): String = when {
+  uri.startsWith(CORE_LINK_PREFIX) -> HEARTH_LINK_PREFIX + uri.removePrefix(CORE_LINK_PREFIX)
+  CORE_SHORT_LINK.containsMatchIn(uri) -> HEARTH_SHORT_LINK_PREFIX + uri.removePrefix(CORE_SHORT_LINK_PREFIX)
+  else -> uri
+}
+
+// Граница слева: в «myhearth://» и «x.hearth:/» это не наши ссылки.
+private val HEARTH_SHORT_ANYWHERE = Regex("(?<![A-Za-z0-9+.-])hearth://")
+private val HEARTH_FULL_ANYWHERE = Regex("(?<![A-Za-z0-9+.-])hearth:/(?!/)")
+
+/**
+ * Вернуть ядру его ссылки — во всём тексте, а не только в начале: человек вставляет
+ * «вот моя ссылка: …», и такой текст тоже должен разбираться.
  */
-fun simplexChatLink(uri: String): String =
-  if (uri.startsWith(CORE_LINK_PREFIX)) HEARTH_LINK_PREFIX + uri.removePrefix(CORE_LINK_PREFIX)
-  else uri
+fun hearthLinksToCore(text: String): String =
+  text.replace(HEARTH_SHORT_ANYWHERE, CORE_SHORT_LINK_PREFIX)
+    .replace(HEARTH_FULL_ANYWHERE, CORE_LINK_PREFIX)
 
-/** Обратно к тому, что понимает ядро. Терпит и старый вид, и чужой домен. */
+/** Одна ссылка обратно к виду ядра. Терпит пробелы по краям, старый вид и чужой домен. */
 fun hearthLinkToCore(uri: String): String {
-  val s = uri.trim()
-  return when {
-    s.startsWith(HEARTH_LINK_PREFIX) -> CORE_LINK_PREFIX + s.removePrefix(HEARTH_LINK_PREFIX)
-    // Ссылки, выданные до перехода на свою схему, и ссылки от стокового SimpleX.
-    s.startsWith("https://simplex.chat/") -> CORE_LINK_PREFIX + s.removePrefix("https://simplex.chat/")
-    else -> s
-  }
+  val s = hearthLinksToCore(uri.trim())
+  // Полные ссылки от стокового SimpleX: ядро понимает и их, но к общему виду приводим,
+  // чтобы разбор шёл одной дорогой.
+  return if (s.startsWith("https://simplex.chat/")) CORE_LINK_PREFIX + s.removePrefix("https://simplex.chat/") else s
 }
 
