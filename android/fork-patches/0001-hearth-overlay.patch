+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  ТЗ §3.1 "Утечка через бэкапы ОС" and acceptance test A9.
+
+  Android 12+ honours this file for both cloud backup and device-to-device transfer.
+  Everything is excluded: the app's database holds the message history and the relay
+  credentials, and a Google-side copy of that is exactly the dependency this project
+  exists to remove.
+-->
+<data-extraction-rules>
+    <cloud-backup>
+        <exclude domain="root" />
+        <exclude domain="database" />
+        <exclude domain="sharedpref" />
+        <exclude domain="file" />
+        <exclude domain="external" />
+    </cloud-backup>
+    <device-transfer>
+        <exclude domain="root" />
+        <exclude domain="database" />
+        <exclude domain="sharedpref" />
+        <exclude domain="file" />
+        <exclude domain="external" />
+    </device-transfer>
+</data-extraction-rules>
diff --git a/apps/multiplatform/android/src/main/res/xml/hearth_network_security_config.xml b/apps/multiplatform/android/src/main/res/xml/hearth_network_security_config.xml
