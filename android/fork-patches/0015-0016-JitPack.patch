 }
 
 val Indigo = Color(0xFF9966FF)
-val SimplexBlue = Color(0, 136, 255, 255)  // If this value changes also need to update #0088ff in string resource files
+// hearth: фирменный цвет — огонь, а не синий (иконка-костёр, patches/0009).
+//
+// Два оттенка, потому что один и тот же на обеих темах не читается: на белом фоне
+// светлый оранжевый сливается, на чёрном тёмный уходит в грязь. Значения подобраны
+// по контрасту с фоном каждой темы, а не «на глаз в светлой».
+val HearthFlame = Color(0xFFD9480F)        // светлая тема: контраст с белым ~4.7:1
+val HearthFlameBright = Color(0xFFFF922B)  // тёмная тема: контраст с #121212 ~8:1
+
+// Имя upstream оставлено: на него ссылается весь чужой код, и переименование дало бы
+// конфликт в каждом файле при ребейзе ради строчки, которой человек не видит.
+// If this value changes also need to update #d9480f in string resource files
+val SimplexBlue = HearthFlame
 val SimplexGreen = Color(77, 218, 103, 255)
 val SecretColor = Color(0x40808080)
 val LightGray = Color(241, 242, 246, 255)
