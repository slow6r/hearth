diff --git a/apps/multiplatform/common/src/androidMain/kotlin/chat/simplex/common/platform/Images.android.kt b/apps/multiplatform/common/src/androidMain/kotlin/chat/simplex/common/platform/Images.android.kt
index 1a37038..ca3e019 100644
--- a/apps/multiplatform/common/src/androidMain/kotlin/chat/simplex/common/platform/Images.android.kt
+++ b/apps/multiplatform/common/src/androidMain/kotlin/chat/simplex/common/platform/Images.android.kt
@@ -113,7 +113,13 @@ actual fun ImageBitmap.addLogo(size: Float): ImageBitmap = asAndroidBitmap().app
   val paint = android.graphics.Paint()
   paint.color = android.graphics.Color.WHITE
   drawCircle(width / 2f, height / 2f, radius, paint)
-  val logo = androidAppContext.resources.getDrawable(R.drawable.icon_foreground_android_common, null).toBitmap()
+  // Наша drawable лежит в модуле приложения, а R здесь — модуля common, поэтому по
+  // имени, а не по ссылке. Если её вдруг нет (сборка без оверлея), падать нельзя —
+  // берём upstream'овскую: QR должен нарисоваться в любом случае.
+  val res = androidAppContext.resources
+  val hearthId = res.getIdentifier("hearth_icon_foreground", "drawable", androidAppContext.packageName)
+  val logoId = if (hearthId != 0) hearthId else R.drawable.icon_foreground_android_common
+  val logo = res.getDrawable(logoId, null).toBitmap()
   val logoSize = (width * size * 1.5).toInt()
   translate((width - logoSize) / 2f, (height - logoSize) / 2f)
   drawBitmap(logo, null, android.graphics.Rect(0, 0, logoSize, logoSize), null)
