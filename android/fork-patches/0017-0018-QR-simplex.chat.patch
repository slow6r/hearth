-fun simplexChatLink(uri: String): String =
-  if (uri.startsWith("simplex:/")) uri.replace("simplex:/", "https://simplex.chat/")
-  else uri
+// hearth: upstream показывал ссылку как https://simplex.chat/... — то есть звал
+// человека на чужой сайт и подписывал наши приглашения чужим доменом. Схема
+// `simplex:` остаётся: её разбирает ядро на принимающей стороне, и переписать её
+// значит сломать соединение. А вот домен — чистая косметика показа, и он убран.
+fun simplexChatLink(uri: String): String = uri
 
