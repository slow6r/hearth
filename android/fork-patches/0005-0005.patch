allowBackup upstream уже выключил; добавлены dataExtractionRules и
networkSecurityConfig. Плюс tools:node=remove на FCM и геолокацию: сам
upstream их не просит, но манифест собирается слиянием с манифестами
библиотек (ТЗ §3.1, §8.2 п.6, A9).
---
 .../android/src/main/AndroidManifest.xml              | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/apps/multiplatform/android/src/main/AndroidManifest.xml b/apps/multiplatform/android/src/main/AndroidManifest.xml
index 9e059af..b534bcd 100644
--- a/apps/multiplatform/android/src/main/AndroidManifest.xml
+++ b/apps/multiplatform/android/src/main/AndroidManifest.xml
@@ -6,6 +6,13 @@
   <uses-feature android:name="android.hardware.camera" />
 
   <uses-permission android:name="android.permission.CAMERA" />
+
+  <!-- hearth (patches/0005): этих разрешений форк не просит никогда. Upstream их тоже
+       не просит, но манифест собирается слиянием с манифестами библиотек, и tools:node
+       не даст вернуть их незаметно при добавлении зависимости (ТЗ §8.3, A5). -->
+  <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" tools:node="remove" />
+  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
+  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
   <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
   <uses-permission android:name="android.permission.VIDEO_CAPTURE" />
   <uses-permission android:name="android.permission.RECORD_AUDIO" />
@@ -44,7 +51,9 @@
       android:largeHeap="true"
       android:extractNativeLibs="${extract_native_libs}"
       android:supportsRtl="true"
-      android:theme="@style/Theme.SimpleX">
+      android:theme="@style/Theme.SimpleX"
+      android:dataExtractionRules="@xml/hearth_data_extraction_rules"
+      android:networkSecurityConfig="@xml/hearth_network_security_config">
     <!--      android:localeConfig="@xml/locales_config"-->
 
     <!-- Main activity -->
