<?xml version="1.0" encoding="utf-8"?>
<!--
  Иконка Hearth — костёр (patches/0009-branding.md).

  Векторная, а не набор PNG по плотностям: minSdk = 26, значит адаптивная иконка
  применяется на всех поддерживаемых устройствах, и одного файла достаточно.

  Холст адаптивной иконки — 108×108, но лаунчер обрезает его маской и двигает при
  параллаксе. Безопасная зона — центральные 72×72, то есть примерно от 18 до 90.
  Всё значимое здесь укладывается в 30..84, с запасом.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Поленья. Два, крест-накрест, чтобы читалось именно как костёр,
         а не как одинокий язык пламени. -->
    <group
        android:pivotX="54"
        android:pivotY="80"
        android:rotation="16">
        <path
            android:fillColor="#8A5A33"
            android:pathData="M32,76 L76,76 A4,4 0 0,1 76,84 L32,84 A4,4 0 0,1 32,76 Z" />
        <path
            android:fillColor="#6B4526"
            android:pathData="M32,81 L76,81 A4,4 0 0,1 76,84 L32,84 A4,4 0 0,1 32,81 Z" />
    </group>
    <group
        android:pivotX="54"
        android:pivotY="80"
        android:rotation="-16">
        <path
            android:fillColor="#9C6739"
            android:pathData="M32,76 L76,76 A4,4 0 0,1 76,84 L32,84 A4,4 0 0,1 32,76 Z" />
        <path
            android:fillColor="#7A4F2C"
            android:pathData="M32,81 L76,81 A4,4 0 0,1 76,84 L32,84 A4,4 0 0,1 32,81 Z" />
    </group>

    <!-- Внешнее пламя. -->
    <path
        android:fillColor="#F4600C"
        android:pathData="M54,20
            c0,0 -4,10.5 -10,18
            c-5,6.3 -10,11.6 -10,19.4
            C34,68.6 43,77 54,77
            c11,0 20,-8.4 20,-19.6
            c0,-7.8 -5,-13.1 -10,-19.4
            C58,30.5 54,20 54,20 Z" />

    <!-- Внутреннее пламя: горячее ядро. Именно оно делает силуэт огнём,
         а не каплей. -->
    <path
        android:fillColor="#FFB020"
        android:pathData="M54,42
            c0,0 -2.3,5.9 -5.7,10.1
            c-2.8,3.5 -5.7,6.5 -5.7,10.9
            C42.6,69.3 47.7,74 54,74
            c6.3,0 11.4,-4.7 11.4,-11
            c0,-4.4 -2.9,-7.4 -5.7,-10.9
            C56.3,47.9 54,42 54,42 Z" />

    <!-- Самая горячая точка. -->
    <path
        android:fillColor="#FFE68A"
        android:pathData="M54,57
            c0,0 -1.2,3 -2.9,5.1
            c-1.4,1.8 -2.9,3.3 -2.9,5.5
            C48.2,70.9 50.8,73 54,73
            c3.2,0 5.8,-2.1 5.8,-5.4
            c0,-2.2 -1.5,-3.7 -2.9,-5.5
            C55.2,60 54,57 54,57 Z" />
</vector>
